# Supabase — URL e chave pública (anon). Seguras para o navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — chave de service role. NUNCA expor no frontend.
# Usada apenas em código server-side (route handlers / server actions)
# para operações que precisam ignorar RLS de forma controlada (ex: geração de protocolo).
SUPABASE_SERVICE_ROLE_KEY=

# ID (uuid) da empresa que este deploy atende. O sistema é multi-tenant no
# banco (toda denúncia carrega empresa_id e o RLS isola por empresa), mas
# este MVP roda uma empresa por deploy — esta variável define qual delas.
# Nunca inferir "a primeira empresa que existir" no código.
DEFAULT_EMPRESA_ID=
