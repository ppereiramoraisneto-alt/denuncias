# Supabase — URL e chave pública (anon). Seguras para o navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — chave de service role. NUNCA expor no frontend.
# Usada apenas em código server-side (route handlers / server actions)
# para operações que precisam ignorar RLS de forma controlada (ex: geração de protocolo).
SUPABASE_SERVICE_ROLE_KEY=
